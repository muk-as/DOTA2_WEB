  "summerscrub2026_gameplay_ad_bugfix_33": "Spotlight của Ringmaster được cho bởi Aghanim's Shard khi chọn Wheel of Wonder.",
  "summerscrub2026_visual_bugfix_title": "Hình ảnh",
  "summerscrub2026_visual_bugfix_1": "Sửa một số tướng mất ảnh chân dung tùy biến sau khi bị hóa thú.",
  "summerscrub2026_visual_bugfix_2": "Sửa các bộ trang phục tùy biến đôi lúc hiển thị sai trạng thái được mặc.",
  "summerscrub2026_visual_bugfix_3": "Sửa sai biểu tượng trong giao diện chọn tùy biến hình ảnh kỹ năng.",
  "summerscrub2026_visual_bugfix_4": "Sửa kỹ năng bẩm sinh không hiện trong giao diện chọn tùy biến hình ảnh kỹ năng",
  "summerscrub2026_visual_bugfix_5": "Sửa nhiều tùy biến cho biểu tượng báo hiệu bên trên đầu không được vẽ đúng thứ tự, hiện vùng sáng lên trên phần mô hình của hiệu ứng.",
  "summerscrub2026_visual_bugfix_6": "Sửa ngọc khán giả không áp dụng hiệu ứng môi trường lên thú vận chuyển dù đã xem đủ số lượng trận đấu",
  "summerscrub2026_visual_bugfix_7": "Cập nhật biểu tượng vật phẩm cho Splintmail, Prophet's Pendulum, Crella's Crozier, Consecrated Wraps và Hydra's Breath",
  "summerscrub2026_cosmetics_bugfix_title": "Vật phẩm trang trí",
  "summerscrub2026_cosmetics_bugfix_1": "Sửa 'Echoes of the Everblack' và 'Dapper Duo' - Khiêu khích giờ hoạt động với bộ này.",
  "summerscrub2026_cosmetics_bugfix_2": "Sửa 'Molten Claw' - Berserker's Call giờ lần nữa làm vật phẩm này phát sáng.",
  "summerscrub2026_cosmetics_bugfix_3": "Sửa 'Bone Armor' không hiện 'Bộ đầy đủ' trong Kho vũ khí với người chơi sở hữu bộ này nhưng không sở hữu 'Bullfango'.",
  "summerscrub2026_cosmetics_bugfix_4": "Sửa 'Mark of the First Hunt' - Phi tiêu bị sai hướng so với tướng.",
  "summerscrub2026_cosmetics_bugfix_5": "Sửa 'Trappings of the Old-Timers - Shoulder' - Phi tiêu lơ lửng trên không.",
  "summerscrub2026_cosmetics_bugfix_6": "Sửa 'Trappings of the Old-Timers - Back' - Bất kỳ phi tiêu nào ngoại trừ phi tiêu trong bộ này sẽ nằm bên trong ba lô.",
  "summerscrub2026_cosmetics_bugfix_7": "Sửa 'Graxx's Strap' - Hiệu ứng Retaliate lệch bất thường so với nạn nhân.",
  "summerscrub2026_cosmetics_bugfix_8": "Sửa 'Draconic Requiem-Legs' và 'Darkwood Eulogy Belt' - Kết hợp hai vật phẩm này sẽ di chuyển cánh đến vùng eo.",
  "summerscrub2026_cosmetics_bugfix_9": "Sửa 'Rathalos Armor' không hiện 'Bộ đầy đủ' trong Kho vũ khí với người chơi sở hữu bộ này nhưng không sở hữu 'Monster Hunter Rathalos Form'.",
  "summerscrub2026_cosmetics_bugfix_10": "Sửa 'Dread Retribution' và 'Silent Wake of the Crimson Witness' / 'Golden Silent Wake' - Kết hợp các vật phẩm này sẽ chọn sai texture cho Silent Wake.",
  "summerscrub2026_cosmetics_bugfix_11": "Sửa 'Stranger in the Wandering Isles-Head' và 'Dread Retribution - Shoulder Armor' - Kết hợp cả hai vật phẩm này sẽ vô hiệu hiệu ứng hạt nền trên Wander Isles-Head.",
  "summerscrub2026_cosmetics_bugfix_12": "Sửa 'Cinder Sensei Off-Hand Weapon' - Hiệu ứng vật lý trên mô hình giờ áp dụng đúng cách.",
  "summerscrub2026_cosmetics_bugfix_13": "Sửa Call Down thiếu hiệu ứng đốt mặt đất.",
  "summerscrub2026_cosmetics_bugfix_14": "Sửa 'Searing Dominator' và 'Armor of the Ember Demons' - Kết hợp các vật phẩm này làm hoạt ảnh của mũ không chính xác.",
  "summerscrub2026_cosmetics_bugfix_15": "Sửa 'Prism Forge Spirit' - Forge Spirit giờ sẽ thể hiện đúng cử động chết.",
  "summerscrub2026_cosmetics_bugfix_16": "Sửa 'Empowered Barding of the Gods' - Giờ được đặt đúng là vật phẩm dạng thú cưỡi.",
  "summerscrub2026_cosmetics_bugfix_17": "Sửa 'Bird of Prey - Shoulder' - Giờ dựng hình đúng khi nhìn từ mặt trước.",
  "summerscrub2026_cosmetics_bugfix_18": "Sửa 'Blades of Voth Domosh' và 'Legacy of the Fallen Legion' - Giờ cử động Arcana trong phòng thay đồ sẽ phát khi trang bị cả hai món này.",
  "summerscrub2026_cosmetics_bugfix_19": "Sửa 'Blades of Voth Domosh' và 'Lineage Desolate Conquest' - Kết hợp các vật phẩm này sẽ không áp dụng bề mặt Arcana đúng cách.",
  "summerscrub2026_cosmetics_bugfix_20": "Sửa 'Radiant Conqueror Back' và 'Legacy of the Fallen Legion' - Gỡ bỏ một hành động chờ bị thiếu trong các vật phẩm này.",
  "summerscrub2026_cosmetics_bugfix_21": "Sửa 'Perversions of the Bloodwhorl' - Hiệu ứng xoáy Sinister Gaze giờ đã có đúng hình dạng.",
  "summerscrub2026_cosmetics_bugfix_22": "Sửa 'Cauldron of Xahryx' - Hiệu ứng Entangling Claws của Spirit Bear đã hoạt động trở lại.",
  "summerscrub2026_cosmetics_bugfix_23": "Sửa 'Spirit of the Dark Wood' - Kiểu dáng được chọn không áp dụng đúng sau khi Spirit Bear bị hóa thú.",
  "summerscrub2026_cosmetics_bugfix_24": "Sửa 'Bloodmayne Avenger' - Hiệu ứng Howl trên đầu giờ sẽ biến mất khỏi một tướng khi tạo phân thân của tướng đó.",
  "summerscrub2026_cosmetics_bugfix_25": "Sửa 'Horn of the Azurite Warden' - Mô hình này giờ dựng hình đúng cách trong phòng thay đồ và trong trận đấu.",
  "summerscrub2026_cosmetics_bugfix_26": "Sửa 'Axia of Metira' - Vận pháp một tiền đồn không còn dẫn đến đóng băng cử động.",
  "summerscrub2026_cosmetics_bugfix_27": "Sửa 'Mirana of Nightsilver' - Sửa tương tác của một số hiệu ứng phép với vật phẩm này, điển hình là Fire Shield của Ogre Magi.",
  "summerscrub2026_cosmetics_bugfix_28": "Sửa 'Great Sage's Reckoning' và 'Staff of the Masks of Mischief' - kết hợp các vật phẩm này sẽ dựng hình sai texture trong suốt.",
  "summerscrub2026_cosmetics_bugfix_29": "Sửa 'Exodus of the Plague Witch' - Sửa giao điểm giữa váy mặc định và mô hình này.",
  "summerscrub2026_cosmetics_bugfix_30": "Sửa 'Sullen Rampart' - Ghost Shroud lần nữa đã có biểu tượng kỹ năng tùy biến.",
  "summerscrub2026_cosmetics_bugfix_31": "Sửa 'Amber Apis' không hiện dưới 'Bộ đầy đủ' trong kho vũ khí.",
  "summerscrub2026_cosmetics_bugfix_32": "Sửa 'Manifold Paradox' - Đòn đánh chí mạng đôi lúc không dựng hình bóng astral của tướng trúng đòn.",
  "summerscrub2026_cosmetics_bugfix_33": "Sửa 'Feathered Naginata' - Sửa skinning trên mô hình.",
  "summerscrub2026_cosmetics_bugfix_34": "Sửa 'Ripper's Reel' và 'Mindless Slaughter - Arms' hoặc 'Dapper Disguise Hat' - Kết hợp hai vật phẩm này đặt móc vào sai vị trí so với tướng.",
  "summerscrub2026_cosmetics_bugfix_35": "Sửa 'Ripper's Reel' và 'The Abscesserator' - Kết hợp hai vật phẩm này qua ô hiệu ứng kỹ năng sẽ tạo hiệu ứng móc kép.",
  "summerscrub2026_cosmetics_bugfix_36": "Sửa 'Scavenging Guttleslug' - Hiệu ứng hạt của Rot giờ hiện giòi trên mặt đất với đúng thời lượng sống.",
  "summerscrub2026_cosmetics_bugfix_37": "Sửa 'Eye of Ix'yxa' - Hiện ứng hút máu tùy biến giờ áp trong mọi trường hợp.",
  "summerscrub2026_cosmetics_bugfix_38": "Sửa Rubick cướp Meat Hook - phiên bản cướp được của kỹ năng này không còn dùng mô hình móc đã trang bị, nó dùng móc mặc định.",
  "summerscrub2026_cosmetics_bugfix_39": "Sửa hiệu ứng 'The Magus Cypher' cho Call Down.",
  "summerscrub2026_cosmetics_bugfix_40": "Sửa hiệu ứng 'The Magus Cypher' cho Chaotic Offering.",
  "summerscrub2026_cosmetics_bugfix_41": "Sửa hiệu ứng 'The Magus Cypher' cho Cinder Brew.",
  "summerscrub2026_cosmetics_bugfix_42": "Sửa hiệu ứng 'The Magus Cypher' cho Fiend's Gate, và thêm phiên bản xanh lá cho mô hình này.",
  "summerscrub2026_cosmetics_bugfix_43": "Sửa hiệu ứng 'The Magus Cypher' cho Nature's Attendants.",
  "summerscrub2026_cosmetics_bugfix_44": "Sửa hiệu ứng 'The Magus Cypher' cho Noxious Plague.",
  "summerscrub2026_cosmetics_bugfix_45": "Sửa 'The Magus Cypher' - Spectral Dagger của Spectre khi thi triển trên đa mục tiêu giờ ngả màu chính xác.",
  "summerscrub2026_cosmetics_bugfix_46": "Sửa 'The Magus Cypher' - Phép cướp được giờ ngả màu chính xác cho áo choàng.",
  "summerscrub2026_cosmetics_bugfix_47": "Sửa 'Wandering Harlequin's Crest' - Giờ áp dụng biểu tượng kỹ năng tùy biến cho Arcane Supremacy.",
  "summerscrub2026_cosmetics_bugfix_48": "Đã sửa - Thắt lưng mặc định giờ ẩn đúng cách khi trang bị thắt lưng khác.",
  "summerscrub2026_cosmetics_bugfix_49": "Sửa 'Aspect of Oscilla' và 'Mask of the Hazhadal Magebreaker' / 'Hair of the Silent Edict' - Trang bị cả hai vật phẩm này làm hư góc nhìn chân dung.",
  "summerscrub2026_cosmetics_bugfix_50": "Sửa 'Summer Lineage Glaive of the Silvered Talon' - Đường đạn giờ có đúng màu.",
  "summerscrub2026_cosmetics_bugfix_51": "Sửa 'Pale Edge' - Ánh sáng môi trường quanh lưỡi dao giờ được áp dụng lại.",
  "summerscrub2026_cosmetics_bugfix_52": "Sửa 'Top Hat of the Occultist's Pursuit' - Hiệu ứng nền trên mặt Sniper giờ được đặt đúng hướng trong chế độ nhìn chân dung và phòng thay đồ.",
  "summerscrub2026_cosmetics_bugfix_53": "Sửa 'Phantom Advent' - Thành phần giao diện chuỗi giết giờ hiện nếu trang bị kiểu dáng thứ hai.",
  "summerscrub2026_cosmetics_bugfix_54": "Sửa Techies không có cử động thành phù mặc định.",
  "summerscrub2026_cosmetics_bugfix_56": "Sửa 'Swine of the Sunken Galley' giờ có riêng vật phẩm 'Swine Proximity Mine'; món này đã được trao cho tất cả chủ sở hữu Arcana.",
  "summerscrub2026_cosmetics_bugfix_57": "Sửa 'Swine Arsenal' để cập nhật đúng hiệu ứng M.A.D., Sticky Bomb, và Proximity Mine.",
  "summerscrub2026_cosmetics_bugfix_58": "Sửa 'Swine of the Sunken Galley' không có cử động dùng thành phù.",
  "summerscrub2026_cosmetics_bugfix_59": "Sửa cử động chờ hiếm 'Swine of the Sunken Galley' không phát khi đang trong cử động chờ lúc bị thương.",
  "summerscrub2026_cosmetics_bugfix_60": "Sửa 'Swine of the Sunken Galley' với cử động Sticky Bomb bị sai thời điểm.",
  "summerscrub2026_cosmetics_bugfix_61": "Sửa mô hình hiệu ứng hạt của hành động vận pháp chiếm giữ cho 'Swine of the Sunken Galley'.",
  "summerscrub2026_cosmetics_bugfix_62": "Sửa 'Swine of the Sunken Galley' để cho phép hiệu ứng Blast Off! của nó được chọn trong giao diện chọn trang trí cho kỹ năng.",
  "summerscrub2026_cosmetics_bugfix_63": "Sửa 'Pachyderm Powderwagon Remote Mine' - Đơn vị này giờ có camera chân dung phù hợp.",
  "summerscrub2026_cosmetics_bugfix_64": "Sửa 'Deepshock Destroyer' - Tư thế thành phù cho vật phẩm này trước đây hiện sai một xúc tu.",
  "summerscrub2026_cosmetics_bugfix_65": "Sửa 'Frostmoot Tree' - Hiệu ứng nền giờ được ẩn đúng cách nếu cây được ném.",
  "summerscrub2026_cosmetics_bugfix_66": "Sửa 'Tolling Shadows' - Familiar giờ có hiệu ứng nền cho mắt.",
  "summerscrub2026_cosmetics_bugfix_67": "Thêm hiệu ứng 'The Magus Cypher' cho Celestial Hammer của Dawnbreaker.",
  "summerscrub2026_cosmetics_bugfix_68": "Thêm hiệu ứng hình ảnh xung nhịp trên M.A.D. khi nó được lên ngòi.",
  "summerscrub2026_cosmetics_bugfix_69": "Sửa hiệu ứng 'The Magus Cypher' cho Macropyre của Jakiro.",
  "summerscrub2026_misc_bugfix_title": "Khác",
  "summerscrub2026_misc_bugfix_1": "Không cho phép thú vận chuyển mua Shard khi chủ sở hữu đã có hiệu ứng Shard (giữ lại trường hợp đặc biệt cho gấu của Lone Druid).",
  "summerscrub2026_misc_bugfix_2": "Tóm tắt giao tranh giờ cũng hiện hồi máu thực hiện bởi cả hai đội.",
  "summerscrub2026_misc_bugfix_3": "Sửa trường hợp hiếm trong đó các trận đấu không đăng xuất đúng cách, và số lần tạm dừng không giới hạn, nếu hệ thống điều phối trò chơi gặp sự cố giữa trận đấu.",
  "summerscrub2026_misc_bugfix_4": "Sửa lỗi mà trong một số trường hợp, không thể thay thế vật phẩm ghim bên cạnh thanh mua nhanh.",
  "summerscrub2026_misc_bugfix_5": "Sửa lỗi vị trí trên lịch sử trận đấu cho bảng Thống kê tướng và Thống kê số liệu đồng đội.",
  "summerscrub2026_misc_bugfix_6": "Sửa việc tính toán vàng dư ra khi tướng đang hồi sinh. Việc này sửa bảo hộ chuộc mạng không dự đoán đúng số tiền dư ra sau khi chuộc mạng, làm mua nhầm khi đang hồi sinh.",
  "summerscrub2026_misc_bugfix_7": "Sửa một số lỗi tràn giao diện trên bảng điểm sau trận đấu.",
  "summerscrub2026_misc_bugfix_8": "Sửa việc đếm mua Trang bị hỗ trợ mắt/smoke bị sai trong bảng điểm sau trận đấu do thiếu đếm vật phẩm hợp thành một ô.",
  "summerscrub2026_misc_bugfix_9": "Sửa nhiều lỗi kiểu dáng khác nhau trong công cụ chỉnh sửa hướng dẫn.",
  "summerscrub2026_misc_bugfix_10": "Hướng dẫn: Thêm hỗ trợ tương thích ngược cho hướng dẫn cũ; ví dụ, nếu một hướng dẫn khuyến nghị chọn một tiềm năng ở cấp 10, thay vào đó hiện nâng cấp tiếp theo không phải tiềm năng từ hướng dẫn.",
  "summerscrub2026_misc_bugfix_11": "Hướng dẫn: Chỉnh sửa công cụ thiết kế hướng dẫn để bạn không cần gán nâng cấp tiềm năng vào cấp độ tướng nhất định; chúng sẽ luôn được khuyến nghị ngay khi có thể lên cấp.",
  "summerscrub2026_misc_bugfix_12": "Hướng dẫn: Tiềm năng giờ được khuyến nghị bởi hướng dẫn hiện hành ngay khi có thể nâng cấp chúng.",
  "summerscrub2026_misc_bugfix_13": "Đếm bãi quái rừng cộng dồn trên bản đồ nhỏ giờ cũng được cập nhật khi bạn có tầm nhìn lên bãi quái rừng đó.",
  "summerscrub2026_misc_bugfix_14": "Bảng điểm sau trận đấu: Lựa chọn trang bị rừng của người chơi giờ được hiện trong bảng điểm thay vì chỉ trang bị rừng cuối cùng cầm.",
  "summerscrub2026_misc_bugfix_15": "Bảng điểm sau trận đấu: Bảng tổng kết sau trận đấu giờ hiện Điện tri thức chiếm được trong mục Đóng góp hỗ trợ.",
  "summerscrub2026_misc_bugfix_16": "Bảng điểm sau trận đấu: Phá mắt được thêm vào đóng góp hỗ trợ.",
  "summerscrub2026_misc_bugfix_17": "Bảng điểm sau trận đấu: Thêm một mục mới dưới Vàng/XP nhận được cho 'Vàng từ triệu hồi' và 'XP từ triệu hồi', bao gồm đơn vị điều khiển bởi người chơi như quái thu phục, đơn vị của Chen, Spirit Bear, v.v... Chúng không còn được coi là vàng/XP từ quái.",
  "summerscrub2026_misc_bugfix_18": "Gỡ bỏ công cụ chọn khía cạnh và yếu tố giao diện khía cạnh không còn dùng khỏi giai đoạn trước trận đấu, trang cơ sở dữ liệu tướng, và chế độ thử tướng.",
  "summerscrub2026_misc_bugfix_19": "Gỡ bỏ tính năng 'Làm huấn luyện viên / Yêu cầu huấn luyện viên'.",
  "summerscrub2026_misc_bugfix_20": "Khi người chơi dồn bãi quái rừng, đội của người chơi đó sẽ thấy biểu tượng bản đồ nhỏ của họ cập nhật để phản ánh số bãi quái dồn cho đến khi dọn hoàn toàn bãi đó.",
  "summerscrub2026_misc_bugfix_21": "Nhấp kép hoặc dùng menu ngữ cảnh 'Mua vật phẩm' cho vật phẩm cửa hàng/mua nhanh sẽ bỏ qua bảo hộ chuộc mạng.",
  "summerscrub2026_misc_bugfix_22": "Thực hiện một vài tối ưu nhằm giảm thời gian cần để nạp vào trận đấu hoặc chế độ thử tướng.",
  "summerscrub2026_misc_bugfix_23": "Dùng phép thay thế 'Đến cửa hàng ẩn' cho thú vận chuyển, hoặc Alt-nhấp vào menu ngữ cảnh cửa hàng ẩn, giờ sẽ đưa thú vận chuyển đến cửa hàng ẩn của phe địch.",
  "summerscrub2026_labs_bugfix_1": "Phím lọc hiệu ứng để lọc tương tác đơn vị đã được chuyển từ mục thiết lập Dota Labs sang mục thiết lập Phím tắt.",
